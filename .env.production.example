SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=help.example.ru
CSRF_TRUSTED_ORIGINS=https://help.example.ru
USE_SQLITE=False
DATABASE_NAME=help_requests
DATABASE_USER=help_requests_app
DATABASE_PASSWORD=replace-with-a-strong-password
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
PERSONAL_DATA_POLICY_VERSION=replace-with-approved-version
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
USE_X_FORWARDED_PROTO=True
TRUST_X_FORWARDED_FOR=True
RATE_LIMIT_10_MINUTES=5
RATE_LIMIT_24_HOURS=20
CAPTCHA_ENABLED=False
CAPTCHA_PROVIDER=hcaptcha
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# --- Продакшен-домен youngnart.ru по HTTPS (deploy/nginx.https.conf + docker-compose.https.yml) ---
# Значения ниже — то, что нужно выставить в реальном .env при развёртывании под доменом
# (переопределяют примеры ALLOWED_HOSTS/CSRF_TRUSTED_ORIGINS/SECURE_* выше по файлу).

# Домен и его www-алиас, на которые отвечает Django (nginx проксирует оба, www отдаёт 301 на основной).
ALLOWED_HOSTS=youngnart.ru,www.youngnart.ru

# Полные origin (обязательно со схемой https://), с которых доверяем CSRF-запросам.
CSRF_TRUSTED_ORIGINS=https://youngnart.ru,https://www.youngnart.ru

# Принудительный редирект на HTTPS и secure-флаги cookie — включать, только когда сертификат
# уже выпущен (scripts/issue_cert.sh) и сайт реально открывается по https://youngnart.ru.
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# HSTS держим выключенным (0), пока HTTPS не проверен вживую: браузеры запоминают HSTS надолго,
# и откатиться на http в случае проблем с сертификатом будет тяжело. Включать ненулевое значение
# (например, 31536000) только после того, как HTTPS стабильно работает и автопродление сертификата подтверждено.
SECURE_HSTS_SECONDS=0
